{
  "manifest_version": 3,
  "name": "LeadPilot",
  "version": "2.0",
  "description": "Capture leads from LinkedIn Sales Navigator and save them to Google Sheets",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/lib/urlKey.js",
        "src/lib/selectionStore.js",
        "src/lib/selectors.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}